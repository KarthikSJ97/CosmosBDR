PORT="8080"

# Required when running the app in Docker: host path bind-mounted read/write as /host-data in the container.
HOST_DATA_PATH="/absolute/path/to/customer/files"

# Required for docker compose — host bind mounts (absolute paths recommended).
# Keep separate from HOST_DATA_PATH — do not nest backup sources under Seaweed/Postgres dirs.
SEAWEED_DATA_PATH="/absolute/path/to/cosmosbdr_data/seaweed"
POSTGRES_DATA_PATH="/absolute/path/to/cosmosbdr_data/postgres"

SOURCES_CONFIG_PATH="sources.yaml"

# Cadence fan-out (worker only; not in API JSON)
CADENCE_MAX_CONCURRENT_WORKFLOWS=5
# Global activity cap for this worker (all workflows share this pool)
CADENCE_WORKER_MAX_CONCURRENT_ACTIVITIES=10

# Retention GC (Cadence cron + worker batching)
RETENTION_GC_WORKFLOW_ID=retention_gc_daily
RETENTION_GC_CRON_SCHEDULE=0 3 * * *
RETENTION_GC_ITEM_BATCH_SIZE=200
RETENTION_GC_ORPHAN_BATCH_SIZE=500
RETENTION_GC_EXECUTION_TIMEOUT_HOURS=3

POSTGRES_DB_USERNAME="{username}"
POSTGRES_DB_PASSWORD="{password}"
POSTGRES_DB_HOST="{host}"
POSTGRES_DB_PORT="{port}"
POSTGRES_DB_NAME="{db_name}"
POSTGRES_DB_SSL="{ssl}"
POSTGRES_DB_MIGRATIONS_DIRECTORY="src/db/migrations"

SEAWEED_ENDPOINT="http://localhost:8333"
SEAWEED_REGION=""
SEAWEED_ACCESS_KEY="{access_key_16_hex}"
SEAWEED_SECRET_KEY="{secret_key_32_hex}"
SEAWEED_BUCKET="cosmosbdr"

CADENCE_GRPC_HOST="{cadence_grpc_host}"
CADENCE_GRPC_PORT="{cadence_grpc_port}"
CADENCE_UI_HOST="{cadence_ui_host}"
CADENCE_UI_PORT="{cadence_ui_port}"

ENCRYPTION_KEY="{encryption_key_32_hex}"
COMPRESSION_ALGORITHM=gzip # options: zstd, gzip

# --- SFTP source env vars (one block per sources.yaml id) ---
# Prefix: SOURCE_ID as UPPER_SNAKE (e.g. win-home-laptop → WIN_HOME_LAPTOP_<SUFFIX>)
# Suffixes: HOST, USER, REMOTE_ROOT, SSH_KEY, HOST_KEY_FINGERPRINT
#
# Source id: win-home-laptop
WIN_HOME_LAPTOP_HOST="192.168.x.x"
WIN_HOME_LAPTOP_USER="backup-user"
WIN_HOME_LAPTOP_REMOTE_ROOT="D:/path/to/data"
WIN_HOME_LAPTOP_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----\n"
WIN_HOME_LAPTOP_HOST_KEY_FINGERPRINT="SHA256:..."

# --- pre_backup (Phase H Tier 2) — refs from sources.yaml database_ref / password_ref / user_ref / host_ref ---
# PROD_PG_DATABASE="myapp"
# PROD_PG_PASSWORD="secret"
# PROD_PG_USER="postgres"
# PROD_PG_HOST="127.0.0.1"