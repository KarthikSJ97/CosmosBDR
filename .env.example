PORT="8080"

POSTGRES_DB_USERNAME="{username}"
POSTGRES_DB_PASSWORD="{password}"
POSTGRES_DB_HOST="{host}"
POSTGRES_DB_PORT="{port}"
POSTGRES_DB_NAME="{db_name}"
POSTGRES_DB_SSL="{ssl}"
POSTGRES_DB_MIGRATIONS_DIRECTORY="src/db/migrations"

SEAWEED_ENDPOINT="http://localhost:8333"
SEAWEED_REGION=""
SEAWEED_ACCESS_KEY="{access_key_16_hex}"
SEAWEED_SECRET_KEY="{secret_key_32_hex}"
SEAWEED_BUCKET=""

CADENCE_GRPC_HOST="{cadence_grpc_host}"
CADENCE_GRPC_PORT="{cadence_grpc_port}"
CADENCE_UI_HOST="{cadence_ui_host}"
CADENCE_UI_PORT="{cadence_ui_port}"

ENCRYPTION_KEY="{encryption_key_32_hex}"
COMPRESSION_ALGORITHM=gzip # options: zstd, gzip